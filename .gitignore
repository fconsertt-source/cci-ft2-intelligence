# ═══════════════════════════════════════════════════════════════
# CCI-FT2-Intelligence - Production .gitignore
# Last Updated: 2026-02-27
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# Python Virtual Environments
# ═══════════════════════════════════════════════════════════════
.venv/
venv/
env/
ENV/

# ═══════════════════════════════════════════════════════════════
# Python Cache & Build Artifacts
# ═══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
build/
dist/
*.egg-info/
.eggs/

# ═══════════════════════════════════════════════════════════════
# Large Binary Files (GitHub 100MB Limit)
# ═══════════════════════════════════════════════════════════════
*.msi
*.exe
*.jar
*.zip
*.tar.gz
*.rar
*.7z

# ═══════════════════════════════════════════════════════════════
# Runtime Artifacts (Download Separately)
# ═══════════════════════════════════════════════════════════════
assets/runtime/
assets/verifiers/

# Keep manifest only (for auditing)
!assets/runtime/runtime_manifest.json
!assets/verifiers/berlinger/LICENSE.txt

# ═══════════════════════════════════════════════════════════════
# Data Directory (Production Data - Never Commit)
# ═══════════════════════════════════════════════════════════════
data/archive/
data/input_ft2/
data/input_raw/
data/ledger/
data/output/
data/processed/
data/raw/
data/reports/

# Keep .gitkeep for empty directories
!data/.gitkeep
!data/archive/.gitkeep
!data/input_ft2/.gitkeep
!data/input_raw/.gitkeep
!data/ledger/.gitkeep
!data/output/.gitkeep

# ═══════════════════════════════════════════════════════════════
# Logs & Backups
# ═══════════════════════════════════════════════════════════════
*.log
logs/
backup/
backups/
*.bak
*.backup
*.swp
*.tmp
*.temp

# ═══════════════════════════════════════════════════════════════
# IDE & Editor Configurations (Developer-Specific)
# ═══════════════════════════════════════════════════════════════
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.continue/
.qodo/

# ═══════════════════════════════════════════════════════════════
# OS Generated Files
# ═══════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
*.DS_Store
._*

# ═══════════════════════════════════════════════════════════════
# Test & Coverage Artifacts
# ═══════════════════════════════════════════════════════════════
.coverage
*.cover
*.coverage
htmlcov/
nosetests.xml
coverage.xml
.pytest_cache/
.tox/

# ═══════════════════════════════════════════════════════════════
# Weird Files (From Previous Sessions)
# ═══════════════════════════════════════════════════════════════
-H
-v
*import*
*from*

# ═══════════════════════════════════════════════════════════════
# Environment Secrets (Never Commit)
# ═══════════════════════════════════════════════════════════════
.env
.env.local
.env.production
*.pem
*.key
secrets/
credentials/

# ═══════════════════════════════════════════════════════════════
# Documentation Build (If Applicable)
# ═══════════════════════════════════════════════════════════════
docs/_build/
site/

# Duplicate retrospective files (keep only in docs/retrospective/)
docs/project-retrospective.md
docs/project_retrospective.md
# Old retrospective filenames (now in docs/retrospective/)
docs/project-retrospective.md
docs/project_retrospective.md
# Large Binaries (>100MB)
*.msi *.exe *.jar *.zip *.tar.gz
assets/runtime/ assets/verifiers/
data/archive/ data/ledger/ logs/ backups/

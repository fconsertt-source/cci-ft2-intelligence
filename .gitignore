# ===============================
# Python virtual environments
# ===============================
.venv/
venv/
env/
ENV/

# ===============================
# Python cache files
# ===============================
__pycache__/
*.py[cod]
*$py.class

# ===============================
# Backup files / temporary
# ===============================
backup/
backup/*.tar.gz
*.bak
*.swp
*.tmp

# ===============================
# IDE / Editor settings
# ===============================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ===============================
# OS generated files
# ===============================
.DS_Store
Thumbs.db
desktop.ini

# ===============================
# Logs
# ===============================
*.log

# ===============================
# Compiled / build artifacts
# ===============================
*.pyc
*.pyo
*.pyd
build/
dist/
*.egg-info/

# ===============================
# Optional: test output
# ===============================
htmlcov/
.coverage
*.cover
nosetests.xml
coverage.xml

# في ملف .gitignore الرئيسي

# استثناء بيئات التشغيل الكاملة (يتم تحميلها عند النشر)
assets/runtime/jre*/
assets/runtime/jdk*/

# الاحتفاظ بملف التعريف فقط (للتدقيق والمسارات)
!assets/runtime/runtime_manifest.json

# استثناء ملفات JAR الكبيرة إذا كانت تتغير
# (أو احتفظ بها إذا كانت إصدارًا ثابتًا معتمدًا)
assets/verifiers/*.jar


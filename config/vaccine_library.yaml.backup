# ═══════════════════════════════════════════════════════════════
# vaccine_library.yaml — مكتبة اللقاحات المركزية
# نظام CCI-FT2 الإصدار 2.0
# المصادر: WHO/IVB/06.10 · WHO TRS No.999 Annex 5 · CDC Pink Book · UNICEF · نشرات المصنّعين
# ═══════════════════════════════════════════════════════════════

metadata:
  schema_version: "2.0"
  document_version: "2.0.3"
  last_updated: "2026-03-22"
  primary_source: "WHO/IVB/06.10"
  created_by: "CCI-FT2 Team"
  review_status: "approved"

# ═══════════════════════════════════════════════════════════════
# الثوابت العامة (تُطبَّق على جميع اللقاحات ما لم يُذكر خلاف ذلك)
# ═══════════════════════════════════════════════════════════════

defaults:
  reference_temp_c: 5.0          # درجة الحرارة المرجعية WHO
  critical_temp_c: 34.0          # عتبة الحرارة الحرجة (CCM Window D)
  critical_hours: 2.0            # الساعات الحرجة فوق 34°C
  freeze_threshold_c: -0.5       # عتبة التجمد (هامش أمان لمستشعر FT2)
  ccm_default_limit: 600         # حد CCM الافتراضي
  opened_vial_h: 28.0            # مهلة الفتح الافتراضية (ساعات)

# ═══════════════════════════════════════════════════════════════
# مكتبة اللقاحات
# ═══════════════════════════════════════════════════════════════

vaccines:
  
  # ──────────────────────────────────────────────────────────────
  # لقاحات تتحمل التجمد (Freeze-Stable)
  # ──────────────────────────────────────────────────────────────
  
  OPV:
    name_ar: "شلل الأطفال الفموي"
    name_en: "Polio Vaccine (OPV)"
    q10_factor: 3.6
    shelf_life_days: 126
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 300
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    storage: "2-8°C / -25°C إلى -15°C"
    heat_stability: "+37°C لمدة يومين"
    opened_vial_h: 28.0
    protect_light: false
    shake_test: false
    note: "⚠️ Q10=3.6 الأعلى في EPI — الأكثر حساسية للحرارة"
    source: "WHO/IVB/06.10 Table 1"
    who_code: "OPV-001"
    active: true

  MEASLES:
    name_ar: "الحصبة"
    name_en: "Measles Vaccine"
    q10_factor: 2.0
    shelf_life_days: 730
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 400
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    storage: "2-8°C / تجميد مقبول"
    heat_stability: "+37°C لمدة 7 أيام"
    opened_vial_h: 6.0
    protect_light: true
    shake_test: false
    source: "WHO/IVB/06.10"
    who_code: "MV-002"
    active: true

  MMR:
    name_ar: "الحصبة والنكاف والحصبة الألمانية"
    name_en: "MMR Vaccine"
    q10_factor: 2.0
    shelf_life_days: 730
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 400
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    storage: "2-8°C / تجميد مقبول"
    heat_stability: "+37°C لمدة 7 أيام"
    opened_vial_h: 6.0
    protect_light: true
    shake_test: false
    source: "WHO/IVB/06.10; CDC"
    who_code: "MMR-003"
    active: true

  RUBELLA:
    name_ar: "الحصبة الألمانية"
    name_en: "Rubella Vaccine"
    q10_factor: 2.0
    shelf_life_days: 730
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 400
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    storage: "2-8°C"
    opened_vial_h: 6.0
    protect_light: false
    shake_test: false
    source: "WHO/IVB/06.10"
    who_code: "RV-004"
    active: true

  BCG:
    name_ar: "السل"
    name_en: "BCG Vaccine"
    q10_factor: 2.0
    shelf_life_days: 365
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 500
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    storage: "2-8°C / تجميد مقبول"
    heat_stability: "+37°C لمدة 4 أسابيع"
    opened_vial_h: 4.0
    protect_light: true
    shake_test: false
    note: "⚠️ يتلف بالضوء خلال دقائق بعد التركيب"
    source: "WHO/IVB/06.10; WHO PIS BCG"
    who_code: "BCG-005"
    active: true

  YF:
    name_ar: "الحمى الصفراء"
    name_en: "Yellow Fever Vaccine"
    q10_factor: 2.0
    shelf_life_days: 730
    freeze_sensitive: false
    vvm_type: "VVM2"
    ccm_limit: 400
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    heat_stability: "+37°C لمدة 14 يوم"
    opened_vial_h: 1.0
    protect_light: false
    shake_test: false
    note: "⚠️ أقصر مهلة فتح: ساعة واحدة"
    source: "WHO/IVB/06.10 Section 11"
    who_code: "YF-006"
    active: true

  # ──────────────────────────────────────────────────────────────
  # لقاحات حساسة للتجمد (Freeze-Sensitive)
  # ──────────────────────────────────────────────────────────────
  
  HEPB:
    name_ar: "التهاب الكبد B"
    name_en: "Hepatitis B Vaccine"
    q10_factor: 2.0
    shelf_life_days: 1095
    freeze_sensitive: true
    vvm_type: "VVM30"
    ccm_limit: 500
    reference_temp_c: 5.0
    critical_temp_c: 34.0
    critical_hours: 2.0
    heat_stability: "+37°C لمدة 7 أيام"
    opened_vial_h: 28.0
    protect_light: false
    shake_test: true
    note: "⚠️ التجمد يُجمّع HBsAg نهائياً — لا يمكن عكس الضرر"
    source: "WHO/IVB/06.10 Section 7"
    who_code: "HEPB-007"
    active: true

  DTP:
    name_ar: "الثلاثي البكتيري"

    opened_vial_h: 28.0
    protect_light: false
    shake_test: true
    note: "⚠️ الأعلى حساسية للتجمد في EPI — يحتوي ألومنيوم"
    source: "WHO/IVB/06.10 Section 6"
    who_code: "DTP-008"
    active: true

  DTAP:

# ═══════════════════════════════════════════════════════════════
# سجل التغييرات (Change Log)
# ═══════════════════════════════════════════════════════════════

changelog:
  - version: "2.0.3"
    date: "2026-03-22"
    changes:
      - "إضافة reference_temp_c لجميع اللقاحات"
      - "إضافة critical_temp_c لجميع اللقاحات"
      - "إضافة critical_hours لجميع اللقاحات"
      - "إضافة opened_vial_h لجميع اللقاحات"
      - "إصلاح اختبارات VaccineSpecification"
  
  - version: "2.0.2"
    date: "2026-03-21"
    changes:
      - "تحديث OPV: q10_factor من 2.0 إلى 3.6"
      - "تحديث OPV: shelf_life_days من 225 إلى 126"
      - "تحديث BCG: shelf_life_days من 730 إلى 365"
      - "إضافة freeze_sensitive للقاحات الحساسة"
  
  - version: "2.0.1"
    date: "2026-03-20"
    changes:
      - "إضافة لقاحات كوفيد-19"
      - "إضافة حقل who_code"
      - "إضافة حقل active"
  
  - version: "2.0.0"
    date: "2026-03-15"
    changes:
      - "الإصدار الأول من vaccine_library.yaml"
      - "نقل VACCINE_CATALOGUE من الكود إلى YAML"
"""مولد تقرير اللقاحات — مع دعم JudgmentEngine."""

from pathlib import Path
from typing import List

from src.domain.value_objects.vaccine_assessment_result import VaccineAssessmentResult


class VaccinesReportGenerator:
    """مولد تقرير اللقاحات للتصدير إلى TSV."""

    HEADER = [
        "equipment_id", "vaccine_type", "batch_number", "expiry_date",
        "decision", "reason", "her_ratio", "ccm_index", "decision_detail",
        "judgment_risk", "judgment_icon", "confidence",
        "requires_review", "judgment_narrative"
    ]

    def generate(
        self,
        assessments: List[VaccineAssessmentResult],
        output_path: Path,
    ) -> Path:
        output_path.parent.mkdir(parents=True, exist_ok=True)

        with open(output_path, "w", newline="", encoding="utf-8") as f:
            f.write("\t".join(self.HEADER) + "\n")

            for assessment in assessments:
                row = [
                    str(getattr(assessment, 'equipment_id', '')),
                    str(getattr(assessment, 'vaccine_type', '')),
                    str(getattr(assessment, 'batch_number', '')),
                    str(getattr(assessment, 'expiry_date', '')),
                    str(getattr(assessment, 'decision', '')),
                    str(getattr(assessment, 'reason', '')),
                    f"{getattr(assessment, 'her_ratio', 0.0):.3f}",
                    str(getattr(assessment, 'ccm_index', 0)),
                    str(getattr(assessment, 'decision_detail', '')),
                    getattr(assessment, 'judgment_risk', 'SAFE'),
                    getattr(assessment, 'judgment_icon', '🟢'),
                    f"{getattr(assessment, 'confidence', 0.0):.2f}",
                    "Yes" if getattr(assessment, 'requires_review', False) else "No",
                    str(getattr(assessment, 'judgment_narrative', '')).replace("\n", " ").strip()
                ]
                f.write("\t".join(row) + "\n")

        logger.info("✅ تم إنشاء تقرير اللقاحات بنجاح: %s", output_path)
        return output_path
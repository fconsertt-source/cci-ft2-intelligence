# src/application/dtos/center_dto.py
# (انسخ نفس المحتوى إلى src/domain/dtos/center_dto.py)
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional

from src.application.dtos.equipment_dto import EquipmentDTO


# ترتيب الأولوية للقرارات (الأسوأ أولاً)
_DECISION_PRIORITY = [
    "REJECTED_BOTH",
    "REJECTED_FREEZE",
    "REJECTED_HEAT_SEVERE",
    "REJECTED_FREEZE_AND_HEAT_C",
    "REJECTED_HEAT_C",
    "REJECTED_FREEZE_AND_HEAT_B",
    "WARNING_HEAT_B",
    "REJECTED_FREEZE_AND_HEAT_A",
    "REJECTED_FREEZE_SENSITIVE",
    "WARNING_EXCURSION",
    "WARNING_HEAT_A",
    "ACCEPTED",
    "NO_DATA",
    "UNKNOWN",
]


@dataclass
class CenterDTO:
    """
    DTO يمثل مركز التطعيم.
    القرار والإحصائيات مجمَّعة من equipment_units (المعدات).
    """

    id: str
    name: str
    equipment: Dict[str, Any] = field(default_factory=dict)
    temperature_ranges: Dict[str, float] = field(default_factory=dict)
    device_ids: List[str] = field(default_factory=list)
    ft2_entries: List[Any] = field(default_factory=list)
    decision: str = "UNKNOWN"
    vvm_stage: Optional[str] = None
    alert_level: Optional[str] = None
    stability_budget_consumed_pct: float = 0.0
    thaw_remaining_hours: Optional[float] = None
    category_display: Optional[str] = None
    decision_reasons: List[str] = field(default_factory=list)

    decision_thresholds: Dict[str, Any] = field(default_factory=dict)

    # ← الطبقة الوسيطة الجديدة: كل معدة بقراءاتها وقرارها
    equipment_units: List[EquipmentDTO] = field(default_factory=list)

    stats: dict = field(default_factory=dict)

    # يُحسب تلقائياً من equipment — لا يُمرَّر في __init__
    device_ids: List[str] = field(default_factory=list, init=False)

    def __post_init__(self):
        if not self.device_ids and self.equipment:
            self.device_ids = [
                eq.get("device_id")
                for eq in self.equipment.values()
                if eq.get("device_id")
            ]

    # ─── Properties: تجميع من المعدات ────────────────────────────────────────

    @property
    def ft2_entries_count(self) -> int:
        return sum(u.ft2_entries_count for u in self.equipment_units)

    @property
    def has_warning(self) -> bool:
        return any(u.has_warning for u in self.equipment_units)

    def add_ft2_entry(self, entry: Any) -> None:
        """توافق مع الكود القديم — يضيف للمعدة المناسبة أو الأولى"""
        device_id = getattr(entry, "device_id", None)
        for unit in self.equipment_units:
            if unit.device_id == device_id:
                unit.add_ft2_entry(entry)
                return
        # fallback: أضف للمعدة الأولى إن وجدت
        if self.equipment_units:
            self.equipment_units[0].add_ft2_entry(entry)
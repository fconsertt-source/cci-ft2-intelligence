"""
اختبارات تركيب CLI والتكامل مع AppComposer.
"""

import pytest
from typer.testing import CliRunner
from src.presentation.cli import cli  # استيراد تطبيق typer


def test_cli_import_uses_composer(monkeypatch, tmp_path):
    """
    اختبار أن أمر import-ft2 يستخدم AppComposer.create_import_ft2_bundle_uc
    """
    try:
        from src.application.app_composer import AppComposer
    except ImportError:
        pytest.skip("AppComposer not available")

    # إنشاء ملف وهمي
    p = tmp_path / "ft2.txt"
    p.write_text("x")
    called = {}

    class DummyUC:
        def execute(self, input_dir, output_path):
            called["imported"] = True

    monkeypatch.setattr(
        AppComposer,
        "create_import_ft2_bundle_uc",
        staticmethod(lambda: DummyUC())
    )

    runner = CliRunner()
    
    # استدعاء الأمر import-ft2
    result = runner.invoke(
        cli.app,
        ["import-ft2", str(tmp_path), str(tmp_path / "output")]
    )

    assert result.exit_code == 0, f"CLI command failed with exit code {result.exit_code}"
    assert called.get("imported") is True, "The import use case was not called"


def test_cli_generate_uses_composer(monkeypatch):
    """
    اختبار أن أمر generate يستخدم AppComposer.create_generate_device_report_uc
    """
    try:
        from src.application.app_composer import AppComposer
    except ImportError:
        pytest.skip("AppComposer not available")

    called = {}

    class DummyUC:
        def execute(self, device_id):
            called["generated"] = True

    monkeypatch.setattr(
        AppComposer,
        "create_generate_device_report_uc",
        staticmethod(lambda: DummyUC())
    )

    runner = CliRunner()
    
    result = runner.invoke(
        cli.app,
        ["generate", "DEV-001"]
    )

    assert result.exit_code == 0, f"CLI command failed with exit code {result.exit_code}"
    assert called.get("generated") is True, "The generate use case was not called"


def test_cli_evaluate_uses_composer(monkeypatch):
    """
    اختبار أن أمر evaluate يستخدم AppComposer.create_evaluate_uc
    """
    try:
        from src.application.app_composer import AppComposer
    except ImportError:
        pytest.skip("AppComposer not available")

    called = {}

    class DummyUC:
        def execute(self, center_id):
            called["evaluated"] = True

    monkeypatch.setattr(
        AppComposer,
        "create_evaluate_uc",
        staticmethod(lambda: DummyUC())
    )

    runner = CliRunner()
    
    result = runner.invoke(
        cli.app,
        ["evaluate", "CENTER-001"]
    )

    assert result.exit_code == 0, f"CLI command failed with exit code {result.exit_code}"
    assert called.get("evaluated") is True, "The evaluate use case was not called"


def test_cli_help_shows_commands(monkeypatch):
    """
    اختبار أن أمر --help يعرض جميع الأوامر المتاحة
    """
    runner = CliRunner()
    
    result = runner.invoke(cli.app, ["--help"])
    
    assert result.exit_code == 0
    assert "import-ft2" in result.stdout
    assert "generate" in result.stdout
    assert "evaluate" in result.stdout